+def _iter_docx_blocks(doc):
+    """
+    Yield the document's paragraphs and tables in the order they appear.
+    doc.paragraphs skips tables entirely, so any content in a table is lost.
+    """
+    body = doc.element.body
+    for child in body.iterchildren():
+        if isinstance(child, CT_P):
+            yield docx.text.paragraph.Paragraph(child, doc)
+        elif isinstance(child, CT_Tbl):
+            yield docx.table.Table(child, doc)
+
